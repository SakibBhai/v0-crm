generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id              String            @id @default(cuid())
  uid             String?           @unique
  name            String
  company         String
  email           String
  phone           String
  status          String // "hot" | "warm" | "cold"
  stage           String // "new" | "contacted" | "qualified" | "proposal" | "negotiation" | "won" | "lost"
  priority        String // "high" | "medium" | "low"
  category        String
  value           Float
  probability     Int
  source          String
  assignedTo      String
  activities      Int               @default(0)
  tags            String[]
  notes           String            @default("")
  createdAt       DateTime          @default(now())
  lastContact     DateTime          @default(now())
  nextFollowUp    String            @default("")
  starred         Boolean           @default(false)

  noteHistory     NoteHistory[]
  activityHistory ActivityHistory[]

  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
}

model NoteHistory {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  createdBy String

  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model ActivityHistory {
  id               String   @id @default(cuid())
  type             String
  description      String
  timestamp        DateTime @default(now())
  changedBy        String
  changes          Json?
  meetingType      String?
  meetingDetails   String?
  meetingDate      String?
  meetingTime      String?
  meetingLocation  String?
  meetingLink      String?
  meetingAttendees Json?

  leadId           String
  lead             Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Client {
  id                String   @id @default(cuid())
  uid               String?  @unique
  name              String
  email             String
  phone             String
  company           String
  website           String
  address           String
  status            String   // "active" | "inactive" | "paused" | "churned" | "prospect"
  industry          String
  totalRevenue      Float
  monthlyRevenue    Float
  activeProjects    Int
  completedProjects Int
  joinedDate        String
  lastContact       String   @default("")
  avatar            String?
  notes             String   @default("")
  starred           Boolean  @default(false)
  healthScore       Int
  satisfaction      Int
  contractValue     Float
  contractEnd       String
  paymentStatus     String   // "paid" | "pending" | "overdue"
  tags              String[]
  accountManager    String
  tier              String   // "enterprise" | "professional" | "starter"
  engagementScore   Int
  lifetimeValue     Float
  openTickets       Int
  npsScore          Int
  revenueGrowth     Float
  activeCampaigns   Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  leads             Lead[]
}

model Project {
  id                String   @id @default(cuid())
  uid               String?  @unique
  name              String
  description       String   @default("")
  client            String
  clientEmail       String   @default("")
  projectManager    String
  status            String   // planning | in-progress | review | completed | on-hold
  priority          String   @default("medium") // low | medium | high
  progress          Int      @default(0)
  budget            Float    @default(0)
  spent             Float    @default(0)
  startDate         String
  dueDate           String
  team              String[] // initials array
  tasksTotal        Int      @default(0)
  tasksCompleted    Int      @default(0)
  category          String   @default("")
  briefLink         String?
  driveLink         String?
  researchLink      String?
  billingType       String   @default("one-time") // one-time | recurring
  recurringInterval String?  // 7-days | 15-days | 30-days | monthly
  nextBillingDate   String?
  monthlyRate       Float?
  totalBilled       Float    @default(0)
  paymentStatus     String   @default("pending") // pending | partial | paid | overdue
  files             Json     @default("[]")
  discussions       Json     @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Task {
  id               String   @id @default(cuid())
  title            String
  description      String   @default("")
  status           String   // backlog | todo | in-progress | in-review | done
  priority         String   @default("medium") // low | medium | high | critical
  taskType         String   @default("general")
  projectId        String
  projectName      String
  assignees        Json     @default("[]")
  assignedById     String   @default("")
  assignedByName   String   @default("")
  reporterId       String   @default("")
  reporterName     String   @default("")
  dueDate          String
  startDate        String?
  tags             String[]
  subtasks         Json     @default("[]")
  comments         Json     @default("[]")
  attachments      Json     @default("[]")
  dependencies     Json     @default("[]")
  timeEntries      Json     @default("[]")
  referenceLinks   Json     @default("[]")
  activityLog      Json     @default("[]")
  estimatedHours   Float    @default(0)
  actualHours      Float    @default(0)
  isBlocked        Boolean  @default(false)
  isRecurring      Boolean  @default(false)
  recurringPattern String?
  customFields     Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model FinanceInvoice {
  id                String   @id @default(cuid())
  invoiceNumber     String   @unique
  client            String
  clientEmail       String   @default("")
  project           String
  projectId         String   @default("")
  amount            Float    @default(0)
  paid              Float    @default(0)
  tax               Float    @default(0)
  discount          Float    @default(0)
  status            String   // draft | sent | pending | partial | paid | overdue
  dueDate           String
  issueDate         String
  paidDate          String?
  paymentMethod     String   @default("Bank Transfer")
  paymentTerms      String   @default("Net 30")
  currency          String   @default("BDT")
  items             Json     @default("[]")
  notes             String   @default("")
  internalNotes     String   @default("")
  category          String   @default("development")
  recurringInvoice  Boolean  @default(false)
  attachments       Json     @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model FinanceIncome {
  id                  String   @id @default(cuid())
  description         String
  category            String
  subCategory         String   @default("")
  amount              Float
  date                String
  client              String   @default("")
  project             String   @default("")
  status              String   @default("received")
  entityStatus        String   @default("active")
  invoiceId           String?
  paymentMethod       String   @default("Bank Transfer")
  recurring           Boolean  @default(false)
  recurringFrequency  String?
  taxAmount           Float    @default(0)
  notes               String   @default("")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model FinanceExpense {
  id                  String   @id @default(cuid())
  description         String
  category            String
  subCategory         String   @default("")
  amount              Float
  date                String
  vendor              String
  status              String   @default("pending")
  entityStatus        String   @default("active")
  recurring           Boolean  @default(false)
  recurringFrequency  String?
  approvalStatus      String   @default("pending")
  approvedBy          String?
  paymentMethod       String   @default("Bank Transfer")
  receiptUrl          String?
  taxDeductible       Boolean  @default(true)
  notes               String   @default("")
  department          String   @default("general")
  project             String?
  sourceType          String   @default("office")
  clientId            String?
  clientName          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model TeamEmployee {
  id                String   @id @default(cuid())
  firstName         String
  lastName          String
  email             String
  phone             String   @default("")
  employeeId        String   @unique
  jobTitle          String
  department        String
  employmentType    String   @default("full-time")
  status            String   @default("active")
  managerId         String?
  managerName       String?
  startDate         String
  endDate           String?
  workLocation      String   @default("Remote")
  salary            Float    @default(0)
  currency          String   @default("BDT")
  payFrequency      String   @default("monthly")
  skills            Json     @default("[]")
  yearsOfExperience Int      @default(0)
  certifications    Json     @default("[]")
  performanceRating Float    @default(0)
  documents         Json     @default("[]")
  careerHistory     Json     @default("[]")
  emergencyContacts Json     @default("[]")
  leaveBalance      Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model TeamCandidate {
  id             String   @id @default(cuid())
  firstName      String
  lastName       String
  email          String
  phone          String   @default("")
  position       String
  department     String
  stage          String   @default("applied")
  source         String   @default("")
  appliedAt      String
  notes          Json     @default("[]")
  interviews     Json     @default("[]")
  rating         Float    @default(0)
  expectedSalary Float?
  availableFrom  String?
  skills         Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model TeamLeaveRequest {
  id              String   @id @default(cuid())
  employeeId      String
  employeeName    String
  leaveType       String
  startDate       String
  endDate         String
  totalDays       Int
  reason          String
  status          String   @default("pending")
  approverId      String?
  approverName    String?
  approvedAt      String?
  rejectionReason String?
  createdAt       DateTime @default(now())
}

model TeamAttendanceRecord {
  id           String   @id @default(cuid())
  employeeId   String
  employeeName String
  date         String
  status       String
  clockIn      String?
  clockOut     String?
  breakMinutes Int?
  totalHours   Float?
  workLocation String?
  notes        String?
  markedAt     DateTime @default(now())
}

model TeamOKR {
  id              String   @id @default(cuid())
  employeeId      String
  title           String
  description     String   @default("")
  quarter         String
  keyResults      Json     @default("[]")
  overallProgress Float    @default(0)
  status          String   @default("on-track")
  parentOKRId     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TeamPerformanceReview {
  id                    String   @id @default(cuid())
  employeeId            String
  employeeName          String
  reviewerId            String
  reviewerName          String
  period                String
  scheduledDate         String
  status                String   @default("scheduled") // scheduled | in-progress | completed
  overallRating         Float    @default(0)
  competencyRatings     Json     @default("[]")
  strengths             Json     @default("[]")
  areasForImprovement   Json     @default("[]")
  goals                 Json     @default("[]")
  salaryChange          Float?
  promotionRecommended  Boolean  @default(false)
  pipRequired           Boolean  @default(false)
  completedAt           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model TeamTrainingCourse {
  id                  String   @id @default(cuid())
  title               String
  description         String   @default("")
  type                String   @default("optional") // mandatory | optional | certification
  category            String   @default("technical")
  duration            Float    @default(0)
  provider            String   @default("")
  format              String   @default("online") // online | in-person | hybrid
  certificationExpiry Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model TeamCourseEnrollment {
  id             String   @id @default(cuid())
  courseId        String
  courseName      String
  employeeId      String
  status          String   @default("enrolled") // enrolled | in-progress | completed | failed
  progress        Float    @default(0)
  enrolledAt      String
  completedAt     String?
  score           Float?
  certificateUrl  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
