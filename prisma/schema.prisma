generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== Auth Models ====================

enum UserRole {
  SUPER_ADMIN
  MANAGEMENT
  MANAGER
  EMPLOYEE
  CLIENT
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  role          UserRole  @default(EMPLOYEE)
  avatar        String?
  isActive      Boolean   @default(true)
  lastLogin     DateTime?

  employeeId    String?   @unique
  employee      TeamEmployee? @relation(fields: [employeeId], references: [id])
  clientId      String?   @unique
  client        Client?   @relation("ClientUser", fields: [clientId], references: [id])

  sessions      Session[]
  notifications Notification[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==================== CRM Models ====================

model Lead {
  id              String            @id @default(cuid())
  name            String
  company         String            @default("")
  email           String            @default("")
  phone           String
  status          String            @default("warm")
  stage           String            @default("new")
  priority        String            @default("medium")
  category        String            @default("other")
  value           Float             @default(0)
  probability     Int               @default(50)
  source          String            @default("Website")
  assignedTo      String            @default("Unassigned")
  activities      Int               @default(0)
  tags            String[]
  notes           String            @default("")
  website         String            @default("")
  pageLink        String            @default("")
  createdAt       DateTime          @default(now())
  lastContact     DateTime          @default(now())
  nextFollowUp    String            @default("")
  starred         Boolean           @default(false)
  clientId        String?
  uid             String?           @unique
  activityHistory ActivityHistory[]
  client          Client?           @relation(fields: [clientId], references: [id])
  noteHistory     NoteHistory[]
  followUps       LeadFollowUp[]
}

model NoteHistory {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  createdBy String
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model LeadFollowUp {
  id        String   @id @default(cuid())
  date      String
  notes     String   @default("")
  status    String   @default("scheduled")
  createdAt DateTime @default(now())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model ActivityHistory {
  id               String   @id @default(cuid())
  type             String
  description      String
  timestamp        DateTime @default(now())
  changedBy        String
  changes          Json?
  meetingType      String?
  meetingDetails   String?
  meetingDate      String?
  meetingTime      String?
  meetingLocation  String?
  meetingLink      String?
  meetingAttendees Json?
  leadId           String
  lead             Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Client {
  id                String   @id @default(cuid())
  name              String
  email             String
  phone             String
  company           String
  website           String
  address           String
  status            String
  industry          String
  totalRevenue      Float
  monthlyRevenue    Float
  activeProjects    Int
  completedProjects Int
  joinedDate        String
  lastContact       String   @default("")
  avatar            String?
  notes             String   @default("")
  starred           Boolean  @default(false)
  healthScore       Int
  satisfaction      Int
  contractValue     Float
  contractEnd       String
  paymentStatus     String
  tags              String[]
  accountManager    String
  tier              String
  engagementScore   Int
  lifetimeValue     Float
  openTickets       Int
  npsScore          Int
  revenueGrowth     Float
  activeCampaigns   Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  uid               String?  @unique
  leads             Lead[]
  user              User?   @relation("ClientUser")
}

model Project {
  id                String   @id @default(cuid())
  name              String
  description       String   @default("")
  client            String
  clientEmail       String   @default("")
  projectManager    String
  status            String
  priority          String   @default("medium")
  progress          Int      @default(0)
  budget            Float    @default(0)
  spent             Float    @default(0)
  startDate         String
  dueDate           String
  team              String[]
  tasksTotal        Int      @default(0)
  tasksCompleted    Int      @default(0)
  category          String   @default("")
  briefLink         String?
  driveLink         String?
  researchLink      String?
  billingType       String   @default("one-time")
  recurringInterval String?
  nextBillingDate   String?
  monthlyRate       Float?
  totalBilled       Float    @default(0)
  paymentStatus     String   @default("pending")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  discussions       Json     @default("[]")
  files             Json     @default("[]")
  uid               String?  @unique
}

model Task {
  id               String   @id @default(cuid())
  title            String
  description      String   @default("")
  status           String
  priority         String   @default("medium")
  taskType         String   @default("general")
  projectId        String
  projectName      String
  assignees        Json     @default("[]")
  assignedById     String   @default("")
  assignedByName   String   @default("")
  reporterId       String   @default("")
  reporterName     String   @default("")
  dueDate          String
  startDate        String?
  tags             String[]
  subtasks         Json     @default("[]")
  comments         Json     @default("[]")
  attachments      Json     @default("[]")
  dependencies     Json     @default("[]")
  timeEntries      Json     @default("[]")
  referenceLinks   Json     @default("[]")
  activityLog      Json     @default("[]")
  estimatedHours   Float    @default(0)
  actualHours      Float    @default(0)
  isBlocked        Boolean  @default(false)
  isRecurring      Boolean  @default(false)
  recurringPattern String?
  customFields     Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model FinanceInvoice {
  id               String   @id @default(cuid())
  invoiceNumber    String   @unique
  client           String
  clientEmail      String   @default("")
  project          String
  projectId        String   @default("")
  amount           Float    @default(0)
  paid             Float    @default(0)
  tax              Float    @default(0)
  discount         Float    @default(0)
  status           String
  dueDate          String
  issueDate        String
  paidDate         String?
  paymentMethod    String   @default("Bank Transfer")
  paymentTerms     String   @default("Net 30")
  currency         String   @default("BDT")
  items            Json     @default("[]")
  notes            String   @default("")
  internalNotes    String   @default("")
  category         String   @default("development")
  recurringInvoice Boolean  @default(false)
  attachments      Json     @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model FinanceIncome {
  id                 String   @id @default(cuid())
  description        String
  category           String
  subCategory        String   @default("")
  amount             Float
  date               String
  client             String   @default("")
  project            String   @default("")
  status             String   @default("received")
  entityStatus       String   @default("active")
  invoiceId          String?
  paymentMethod      String   @default("Bank Transfer")
  recurring          Boolean  @default(false)
  recurringFrequency String?
  taxAmount          Float    @default(0)
  notes              String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model FinanceExpense {
  id                 String   @id @default(cuid())
  description        String
  category           String
  subCategory        String   @default("")
  amount             Float
  date               String
  vendor             String
  status             String   @default("pending")
  entityStatus       String   @default("active")
  recurring          Boolean  @default(false)
  recurringFrequency String?
  approvalStatus     String   @default("pending")
  approvedBy         String?
  paymentMethod      String   @default("Bank Transfer")
  receiptUrl         String?
  taxDeductible      Boolean  @default(true)
  notes              String   @default("")
  department         String   @default("general")
  project            String?
  sourceType         String   @default("office")
  clientId           String?
  clientName         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model TeamEmployee {
  id                String   @id @default(cuid())
  firstName         String
  lastName          String
  email             String
  phone             String   @default("")
  employeeId        String   @unique
  jobTitle          String
  department        String
  employmentType    String   @default("full-time")
  status            String   @default("active")
  managerId         String?
  managerName       String?
  startDate         String
  endDate           String?
  workLocation      String   @default("Remote")
  salary            Float    @default(0)
  currency          String   @default("BDT")
  payFrequency      String   @default("monthly")
  skills            Json     @default("[]")
  yearsOfExperience Int      @default(0)
  certifications    Json     @default("[]")
  performanceRating Float    @default(0)
  documents         Json     @default("[]")
  careerHistory     Json     @default("[]")
  emergencyContacts Json     @default("[]")
  leaveBalance      Json     @default("{}")
  user              User?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model TeamCandidate {
  id             String   @id @default(cuid())
  firstName      String
  lastName       String
  email          String
  phone          String   @default("")
  position       String
  department     String
  stage          String   @default("applied")
  source         String   @default("")
  appliedAt      String
  notes          Json     @default("[]")
  interviews     Json     @default("[]")
  rating         Float    @default(0)
  expectedSalary Float?
  availableFrom  String?
  skills         Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model TeamLeaveRequest {
  id              String   @id @default(cuid())
  employeeId      String
  employeeName    String
  leaveType       String
  startDate       String
  endDate         String
  totalDays       Int
  reason          String
  status          String   @default("pending")
  approverId      String?
  approverName    String?
  approvedAt      String?
  rejectionReason String?
  createdAt       DateTime @default(now())
}

model TeamAttendanceRecord {
  id           String   @id @default(cuid())
  employeeId   String
  employeeName String
  date         String
  status       String
  clockIn      String?
  clockOut     String?
  breakMinutes Int?
  totalHours   Float?
  workLocation String?
  notes        String?
  markedAt     DateTime @default(now())

  @@unique([employeeId, date])
}

model TeamOKR {
  id              String   @id @default(cuid())
  employeeId      String
  title           String
  description     String   @default("")
  quarter         String
  keyResults      Json     @default("[]")
  overallProgress Float    @default(0)
  status          String   @default("on-track")
  parentOKRId     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TeamPerformanceReview {
  id                   String   @id @default(cuid())
  employeeId           String
  employeeName         String
  reviewerId           String
  reviewerName         String
  period               String
  scheduledDate        String
  status               String   @default("scheduled")
  overallRating        Float    @default(0)
  competencyRatings    Json     @default("[]")
  strengths            Json     @default("[]")
  areasForImprovement  Json     @default("[]")
  goals                Json     @default("[]")
  salaryChange         Float?
  promotionRecommended Boolean  @default(false)
  pipRequired          Boolean  @default(false)
  completedAt          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model TeamTrainingCourse {
  id                  String   @id @default(cuid())
  title               String
  description         String   @default("")
  type                String   @default("optional")
  category            String   @default("technical")
  duration            Float    @default(0)
  provider            String   @default("")
  format              String   @default("online")
  certificationExpiry Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model TeamCourseEnrollment {
  id             String   @id @default(cuid())
  courseId       String
  courseName     String
  employeeId     String
  status         String   @default("enrolled")
  progress       Float    @default(0)
  enrolledAt     String
  completedAt    String?
  score          Float?
  certificateUrl String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model TeamHoliday {
  id          String   @id @default(cuid())
  date        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
}

// ==================== Settings (single-row) ====================

model Notification {
  id          String   @id @default(cuid())
  type        String   // e.g., "lead_assigned", "task_reminder", "invoice_paid", etc.
  title       String
  message     String
  isRead      Boolean  @default(false)
  link        String?  // Optional link to navigate to
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model Settings {
  id                  String   @id @default("default")

  // Organization
  companyName         String   @default("Your Company")
  companyLogo         String?
  website             String   @default("")
  businessEmail       String   @default("")
  phone               String   @default("")
  taxId               String   @default("")
  address             String   @default("")

  // Regional
  timezone            String   @default("utc+6")
  currency            String   @default("bdt")
  dateFormat          String   @default("dmy")
  fiscalYearStart     String   @default("jan")

  // Invoice Templates
  invoicePrefix       String   @default("INV")
  invoiceStartNumber  Int      @default(1001)
  logoPosition        String   @default("left")
  accentColor         String   @default("#3b82f6")
  paymentTermsText    String   @default("Payment is due within 30 days. Late payments may incur a fee of 1.5% per month.")
  defaultNotes        String   @default("Thank you for your business!")

  // Finance
  defaultPaymentTerms String   @default("net30")
  latePaymentFee      Float    @default(1.5)
  paymentMethods      Json     @default("[{\"name\":\"Bank Transfer\",\"enabled\":true},{\"name\":\"Credit Card\",\"enabled\":true},{\"name\":\"Cash\",\"enabled\":true},{\"name\":\"Check\",\"enabled\":false},{\"name\":\"Mobile Payment\",\"enabled\":true},{\"name\":\"PayPal\",\"enabled\":false}]")
  taxConfigs          Json     @default("[{\"id\":\"1\",\"name\":\"Standard VAT\",\"rate\":15,\"isDefault\":true},{\"id\":\"2\",\"name\":\"Reduced VAT\",\"rate\":5,\"isDefault\":false},{\"id\":\"3\",\"name\":\"Zero Rate\",\"rate\":0,\"isDefault\":false}]")

  // Pipeline & Leads
  pipelineStages      Json     @default("[{\"id\":\"1\",\"name\":\"New\",\"color\":\"#64748b\",\"probability\":10,\"order\":0},{\"id\":\"2\",\"name\":\"Contacted\",\"color\":\"#3b82f6\",\"probability\":25,\"order\":1},{\"id\":\"3\",\"name\":\"Qualified\",\"color\":\"#06b6d4\",\"probability\":40,\"order\":2},{\"id\":\"4\",\"name\":\"Proposal\",\"color\":\"#8b5cf6\",\"probability\":60,\"order\":3},{\"id\":\"5\",\"name\":\"Negotiation\",\"color\":\"#f59e0b\",\"probability\":80,\"order\":4},{\"id\":\"6\",\"name\":\"Won\",\"color\":\"#22c55e\",\"probability\":100,\"order\":5},{\"id\":\"7\",\"name\":\"Lost\",\"color\":\"#ef4444\",\"probability\":0,\"order\":6}]")
  leadCategories      Json     @default("[{\"id\":\"1\",\"name\":\"Digital Marketing\",\"color\":\"#8b5cf6\"},{\"id\":\"2\",\"name\":\"SEO\",\"color\":\"#22c55e\"},{\"id\":\"3\",\"name\":\"Social Media\",\"color\":\"#ec4899\"},{\"id\":\"4\",\"name\":\"Content\",\"color\":\"#06b6d4\"},{\"id\":\"5\",\"name\":\"Branding\",\"color\":\"#f97316\"},{\"id\":\"6\",\"name\":\"Web Development\",\"color\":\"#6366f1\"},{\"id\":\"7\",\"name\":\"PPC\",\"color\":\"#f43f5e\"}]")

  // Client Settings
  clientTiers         Json     @default("[{\"name\":\"Enterprise\",\"minValue\":100000,\"color\":\"#f59e0b\"},{\"name\":\"Professional\",\"minValue\":25000,\"color\":\"#3b82f6\"},{\"name\":\"Starter\",\"minValue\":0,\"color\":\"#64748b\"}]")
  healthScoreWeights  Json     @default("[{\"factor\":\"Payment History\",\"weight\":30},{\"factor\":\"Engagement\",\"weight\":25},{\"factor\":\"Project Activity\",\"weight\":25},{\"factor\":\"NPS Score\",\"weight\":20}]")

  // Tasks & Projects
  taskStatuses        Json     @default("[\"Backlog\",\"To Do\",\"In Progress\",\"In Review\",\"Done\",\"Blocked\"]")
  taskAutomation      Boolean  @default(true)

  // Notifications
  notifications       Json     @default("[{\"id\":\"1\",\"title\":\"New Lead Assigned\",\"description\":\"Get notified when a new lead is assigned to you\",\"email\":true,\"push\":true,\"sms\":false},{\"id\":\"2\",\"title\":\"Task Reminders\",\"description\":\"Receive reminders for upcoming task deadlines\",\"email\":true,\"push\":true,\"sms\":true},{\"id\":\"3\",\"title\":\"Invoice Paid\",\"description\":\"Notification when an invoice is paid\",\"email\":true,\"push\":true,\"sms\":false},{\"id\":\"4\",\"title\":\"Client Messages\",\"description\":\"Notifications for new client communications\",\"email\":true,\"push\":true,\"sms\":true},{\"id\":\"5\",\"title\":\"Overdue Payments\",\"description\":\"Alerts for overdue invoice payments\",\"email\":true,\"push\":true,\"sms\":true},{\"id\":\"6\",\"title\":\"Weekly Reports\",\"description\":\"Receive weekly summary reports\",\"email\":true,\"push\":false,\"sms\":false}]")

  // Integrations
  integrations        Json     @default("[{\"name\":\"Google Calendar\",\"connected\":false},{\"name\":\"Stripe\",\"connected\":false},{\"name\":\"Slack\",\"connected\":false},{\"name\":\"QuickBooks\",\"connected\":false}]")

  // Email Templates
  emailTemplates      Json     @default("[{\"id\":\"1\",\"name\":\"Invoice Sent\",\"description\":\"Sent when invoice is issued to client\",\"subject\":\"Invoice #{invoiceNumber} from {companyName}\",\"body\":\"Dear {clientName},\\n\\nPlease find attached invoice #{invoiceNumber} for {amount}.\\n\\nPayment is due by {dueDate}.\\n\\nThank you for your business!\\n\\n{companyName}\"},{\"id\":\"2\",\"name\":\"Payment Reminder\",\"description\":\"Reminder for upcoming/overdue payments\",\"subject\":\"Payment Reminder: Invoice #{invoiceNumber}\",\"body\":\"Dear {clientName},\\n\\nThis is a friendly reminder that invoice #{invoiceNumber} for {amount} is due on {dueDate}.\\n\\nPlease make the payment at your earliest convenience.\\n\\nThank you,\\n{companyName}\"},{\"id\":\"3\",\"name\":\"Payment Received\",\"description\":\"Confirmation when payment is received\",\"subject\":\"Payment Received - Invoice #{invoiceNumber}\",\"body\":\"Dear {clientName},\\n\\nWe have received your payment of {amount} for invoice #{invoiceNumber}.\\n\\nThank you for your prompt payment!\\n\\nBest regards,\\n{companyName}\"},{\"id\":\"4\",\"name\":\"Welcome Email\",\"description\":\"Sent to new clients\",\"subject\":\"Welcome to {companyName}!\",\"body\":\"Dear {clientName},\\n\\nWelcome aboard! We are thrilled to have you as our valued client.\\n\\nIf you have any questions, feel free to reach out.\\n\\nBest regards,\\n{companyName}\"}]")

  // Appearance
  compactMode         Boolean  @default(false)
  animations          Boolean  @default(true)
  sidebarCollapsed    Boolean  @default(false)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
